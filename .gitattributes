# git archive builds installable releases; keep bundled library notices in Libs/.
/.gitattributes export-ignore
/.github export-ignore
/.gitignore export-ignore
/AGENTS.md export-ignore
/README.md export-ignore
/docs export-ignore
/tests export-ignore
/tools export-ignore
# Keep the full-resolution source; only Icon.tga is used by the addon.
/Media/Icon.png export-ignore
